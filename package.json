{
  "name": "@compootor/stooart",
  "version": "0.1.1",
  "private": true,
  "description": "Policy-first task routing with Effect and optional Jev selection",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stoopid-computers/stooart.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint --force",
    "dev": "node --experimental-strip-types src/cli.ts",
    "test": "vp test",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint --type-aware",
    "lint:actions": "actionlint",
    "fmt": "vp fmt",
    "check": "vp check && pnpm lint:actions && pnpm test",
    "build:native": "node --experimental-strip-types scripts/build-native.ts",
    "test:native": "node --experimental-strip-types scripts/smoke-native.ts",
    "pack:local": "node --experimental-strip-types scripts/pack.ts --local",
    "release:pack": "node --experimental-strip-types scripts/pack.ts",
    "release:verify": "node --experimental-strip-types scripts/verify-release.ts"
  },
  "dependencies": {
    "@compootor/effective-jev": "0.0.4",
    "@effect/platform-node": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@effect/tsgo": "0.47.0",
    "@kjanat/actionlint": "1.17.0",
    "@oxlint/plugins": "1.79.0",
    "@scriptc/compiler": "0.1.7",
    "@types/deno": "2.7.0",
    "@types/node": "24.10.0",
    "typescript": "7.0.2",
    "vite-plus": "1.0.0"
  },
  "engines": {
    "node": ">=24.10.0"
  },
  "packageManager": "pnpm@12.3.4"
}
