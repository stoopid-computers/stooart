+  scr_child_on_close(child, isl_child_callback(ctx, argv[7], "close", (void *)isl_child_exit), isl_child_exit);
+  scr_child_on_error(child, isl_child_callback(ctx, argv[7], "error", (void *)isl_child_error), isl_child_error);
+  ScrChildStream *streams[] = {scr_child_stdout(child), scr_child_stderr(child)};
+  const char *events[] = {"stdout", "stderr"};
+  const char *ends[] = {"stdoutEnd", "stderrEnd"};
+  for (int i = 0; i < 2; i++) {
+    if (!streams[i]) continue;
