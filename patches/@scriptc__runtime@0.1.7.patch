+  if (!command || !args || !cwd || (has_env && !env)) {
+    if (command) scr_str_release(command);
+    if (args) scr_arr_release(args);
+    if (cwd) scr_str_release(cwd);
+    if (env) scr_arr_release(env);
+    return JS_EXCEPTION;
+  }
+  double modes[5] = {0};
+  for (uint32_t i = 0; i < 5; i++) {
+    JSValue mode = JS_GetPropertyUint32(ctx, argv[2], i);
+    JS_ToFloat64(ctx, &modes[i], mode);
+    JS_FreeValue(ctx, mode);
+  }
+  ScrChild *child = scr_spawn_opts(command, args, modes[0], modes[1], modes[2], modes[3], modes[4],
+                                  JS_ToBool(ctx, argv[3]) > 0, JS_ToBool(ctx, argv[4]) > 0,
+                                  has_env, env, cwd);
