+/* Reuse the native asynchronous child registry for embedded Node packages.
+ * Callback captures live until the native child/stream settles. */
+typedef struct {
+  size_t rc;
+  JSContext *ctx;
+  JSValue fn;
+  const char *event;
+} IslChildCallback;
+
+static void *isl_child_callback_retain(void *p) {
+  ((IslChildCallback *)p)->rc++;
+  return p;
+}
+
+static void isl_child_callback_release(void *p) {
+  IslChildCallback *h = p;
+  if (--h->rc == 0) {
+    JS_FreeValue(h->ctx, h->fn);
+    free(h);
+  }
+}
+
+static ScrClosure *isl_child_callback(JSContext *ctx, JSValueConst fn,
+                                      const char *event, void *body) {
+  IslChildCallback *h = malloc(sizeof *h);
+  if (!h) abort();
+  *h = (IslChildCallback){1, ctx, JS_DupValue(ctx, fn), event};
+  ScrBox *box = scr_box_new_obj(isl_child_callback_retain, isl_child_callback_release, NULL);
+  scr_box_set_ref(box, h);
+  ScrClosure *cb = scr_closure_new(body, 1);
+  cb->caps[0] = box;
+  return cb;
+}
+
+static void isl_child_emit(IslChildCallback *h, JSValue value, JSValue signal) {
+  JSValue args[] = {JS_NewString(h->ctx, h->event), value, signal};
+  JSValue result = JS_Call(h->ctx, h->fn, JS_UNDEFINED, 3, args);
+  for (int i = 0; i < 3; i++) JS_FreeValue(h->ctx, args[i]);
+  if (JS_IsException(result)) scr_island_bridge_exception();
+  else {
+    JS_FreeValue(h->ctx, result);
+    scr_island_drain_jobs();
+  }
+}
+
+static void isl_child_data(ScrClosure *cb, ScrBytes *bytes) {
+  IslChildCallback *h = scr_box_get_ref(cb->caps[0]);
+  isl_child_emit(h, JS_NewUint8ArrayCopy(h->ctx, bytes->data, (size_t)scr_bytes_len(bytes)), JS_UNDEFINED);
+  isl_child_callback_release(h);
+}
+
+static void isl_child_end(ScrClosure *cb) {
+  IslChildCallback *h = scr_box_get_ref(cb->caps[0]);
+  isl_child_emit(h, JS_UNDEFINED, JS_UNDEFINED);
+  isl_child_callback_release(h);
+}
+
+static void isl_child_exit(ScrClosure *cb, bool has_code, double code, const char *signal) {
+  IslChildCallback *h = scr_box_get_ref(cb->caps[0]);
+  isl_child_emit(h, has_code ? JS_NewFloat64(h->ctx, code) : JS_NULL,
+                signal ? JS_NewString(h->ctx, signal) : JS_NULL);
+  isl_child_callback_release(h);
+}
+
+static void isl_child_error(ScrClosure *cb, ScrStr *message) {
+  IslChildCallback *h = scr_box_get_ref(cb->caps[0]);
+  isl_child_emit(h, JS_NewStringLen(h->ctx, message->data, message->len), JS_UNDEFINED);
+  isl_child_callback_release(h);
+}
+
+static JSClassID isl_child_class_id;
+static JSClassID isl_event_class_id;
+
+typedef struct {
+  ScrClosure *callback;
+  double signal;
+} IslEventSubscription;
+
+static void isl_event_stop(IslEventSubscription *subscription) {
+  if (subscription->signal == 0) scr_stdin_remove_data(subscription->callback);
+  else scr_signal_off(subscription->signal, subscription->callback);
+  scr_closure_release(subscription->callback);
+  free(subscription);
+}
+
+static void isl_event_finalize(JSRuntime *rt, JSValue value) {
+  (void)rt;
+  IslEventSubscription *subscription = JS_GetOpaque(value, isl_event_class_id);
+  if (subscription) isl_event_stop(subscription);
+}
+
+static JSValue isl_host_event_stop(JSContext *ctx, JSValueConst self, int argc, JSValueConst *argv) {
+  (void)ctx; (void)self; (void)argc;
+  IslEventSubscription *subscription = JS_GetOpaque(argv[0], isl_event_class_id);
+  if (subscription) {
+    JS_SetOpaque(argv[0], NULL);
+    isl_event_stop(subscription);
+  }
+  return JS_UNDEFINED;
+}
+
+static JSValue isl_host_event_start(JSContext *ctx, JSValueConst self, int argc, JSValueConst *argv) {
+  (void)self; (void)argc;
+  double signal = 0;
+  if (JS_ToFloat64(ctx, &signal, argv[0])) return JS_EXCEPTION;
+  IslEventSubscription *subscription = malloc(sizeof *subscription);
+  if (!subscription) return JS_ThrowOutOfMemory(ctx);
+  subscription->signal = signal;
+  subscription->callback = isl_child_callback(ctx, argv[1], signal == 0 ? "data" : "signal",
+                                              signal == 0 ? (void *)isl_child_data : (void *)isl_child_end);
+  if (signal == 0) {
+    scr_stdin_on_data(scr_closure_retain(subscription->callback), isl_child_data, false);
+    scr_stdin_on_end(isl_child_callback(ctx, argv[1], "end", (void *)isl_child_end), true);
+    scr_stdin_on_error(isl_child_callback(ctx, argv[1], "error", (void *)isl_child_error), isl_child_error, true);
+  } else scr_signal_on(signal, scr_closure_retain(subscription->callback), false);
+  JSValue handle = JS_NewObjectClass(ctx, isl_event_class_id);
+  JS_SetOpaque(handle, subscription);
+  return handle;
+}
+
+static JSValue isl_host_raw_mode(JSContext *ctx, JSValueConst self, int argc, JSValueConst *argv) {
+  (void)self; (void)argc;
+  scr_process_stdin_set_raw_mode(JS_ToBool(ctx, argv[0]) > 0);
+  return scr_exc_pending() ? isl_throw_pending(ctx) : JS_UNDEFINED;
+}
+
+static void isl_child_finalize(JSRuntime *rt, JSValue value) {
+  (void)rt;
+  ScrChild *child = JS_GetOpaque(value, isl_child_class_id);
+  if (child) scr_child_release(child);
+}
+
+static ScrArr *isl_child_strings(JSContext *ctx, JSValueConst value) {
+  JSValue length = JS_GetPropertyStr(ctx, value, "length");
+  uint32_t n = 0;
+  JS_ToUint32(ctx, &n, length);
+  JS_FreeValue(ctx, length);
+  ScrArr *items = scr_arr_new(SCR_ELEM_STR, n);
+  for (uint32_t i = 0; i < n; i++) {
+    JSValue item = JS_GetPropertyUint32(ctx, value, i);
+    ScrStr *text = isl_arg_str(ctx, item);
+    JS_FreeValue(ctx, item);
+    if (!text) { scr_arr_release(items); return NULL; }
+    scr_arr_push_ref(items, text);
+  }
+  return items;
+}
