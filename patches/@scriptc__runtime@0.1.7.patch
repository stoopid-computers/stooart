+static JSValue isl_host_child_kill(JSContext *ctx, JSValueConst self, int argc, JSValueConst *argv) {
+  (void)self; (void)argc;
+  ScrChild *child = JS_GetOpaque2(ctx, argv[0], isl_child_class_id);
+  if (!child) return JS_EXCEPTION;
+  ScrStr *signal = isl_arg_str(ctx, argv[1]);
+  if (!signal) return JS_EXCEPTION;
+  bool killed = scr_child_kill(child, signal);
+  scr_str_release(signal);
+  return JS_NewBool(ctx, killed);
+}
+
+static JSValue isl_host_process_kill(JSContext *ctx, JSValueConst self, int argc, JSValueConst *argv) {
+  (void)self; (void)argc;
+  double pid = 0;
+  if (JS_ToFloat64(ctx, &pid, argv[0])) return JS_EXCEPTION;
+  bool killed;
+  if (JS_IsNumber(argv[1])) {
+    double signal = 0;
+    if (JS_ToFloat64(ctx, &signal, argv[1])) return JS_EXCEPTION;
+    killed = scr_process_kill(pid, signal);
+  } else {
+    ScrStr *signal = isl_arg_str(ctx, argv[1]);
+    if (!signal) return JS_EXCEPTION;
+    killed = scr_process_kill_named(pid, signal);
+    scr_str_release(signal);
+  }
+  return scr_exc_pending() ? isl_throw_pending(ctx) : JS_NewBool(ctx, killed);
+}
